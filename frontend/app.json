{
  "expo": {
    "name": "Gritty Fitness",
    "slug": "gritty-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "grittyfitness",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grittyfitness.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gritty Fitness uses your location to track your workout route, distance, and pace.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Gritty Fitness uses background location to continue tracking your workout when the app is in the background.",
        "NSBluetoothPeripheralUsageDescription": "Gritty Fitness connects to heart rate monitors via Bluetooth.",
        "NSBluetoothAlwaysUsageDescription": "Gritty Fitness connects to heart rate monitors via Bluetooth.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.grittyfitness.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE_ROUTE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "react-native-ble-plx",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Gritty Fitness uses background location to continue tracking your workout.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Gritty Fitness reads your Apple Health workouts, heart rate, and route data to import them into the app."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C5CFC"
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b58f18bc-5291-4148-91fc-998bb8950106"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b58f18bc-5291-4148-91fc-998bb8950106"
    }
  }
}

# EAS Build archive excludes.
# NOTE: when this file exists, EAS uses it INSTEAD of .gitignore for the
# upload archive, so it must list everything we don't want uploaded.

# Dependencies (reinstalled on the build server)
node_modules/

# Expo / Metro / web export artifacts
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native folders (regenerated by EAS prebuild from app.json + plugins)
/ios
/android

# Tests & local tooling not needed to build
__tests__/
**/*.test.ts
**/*.test.tsx
jest.config.js
.playwright-mcp/

# Dev junk / screenshots
*.png.orig
grittyfitness-screenshot.png
.DS_Store

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

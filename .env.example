POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://gritty:changeme@localhost:5432/grittyfitness?sslmode=disable
# Generate with `openssl rand -hex 32`. The placeholder below is rejected at startup.
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output
GEMINI_API_KEY=your-gemini-api-key-here
PORT=8080
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=your-email-from-here

# Comma-separated list of allowed CORS origins. Leave unset for localhost dev defaults.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://web.example.com

# Frontend: optional API URL override (for physical device testing, use your LAN IP)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
